# Dockerfile for YDebug development environment
FROM node:24-alpine

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S ydebug -u 1001 -G nodejs

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apk add --no-cache \
    bash \
    curl \
    git

# Copy package files first for better Docker layer caching
COPY package*.json ./

# Install dependencies as root, then change ownership
RUN npm ci --only=development && \
    chown -R ydebug:nodejs /app/node_modules

# Copy application code and set ownership
COPY --chown=ydebug:nodejs . .

# Switch to non-root user
USER ydebug

# Expose Xdebug port for PHP debugging
EXPOSE 9003

# Expose development server port
EXPOSE 3000

# Start development server
CMD ["npm", "run", "dev"]